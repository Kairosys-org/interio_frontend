{
	"name": "interio-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"arch:check": "node scripts/check-architecture.mjs",
		"test": "vitest run",
		"test:unit": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@lucide/svelte": "^1.61.0",
		"clsx": "^2.1.1",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.0.0",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"@vitest/browser-playwright": "^5.0.5",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^7.3.7",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	}
}
